# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Plantilla de variables (sin secretos)
!.env.example

# Archivos de agentes de IA: son instrucciones para herramientas, no parte del proyecto.
# Next 16 vuelve a crear AGENTS.md al correr `next dev`; queda solo en cada equipo.
AGENTS.md
CLAUDE.md
.claude/
