# Copiar como .env.local y completar. .env.local está en .gitignore: nunca se sube.

# Supabase > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://rhtoneixthvfejonusan.supabase.co
# Llave publicable (sb_publishable_...). Viaja al navegador; la protección real es RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Llave secreta (sb_secret_...). Solo servidor; la usa únicamente /api/ingesta.
# Si se expone, se revoca en el panel de Supabase y se crea otra.
SUPABASE_SECRET_KEY=

# Token que Godot envía en Authorization: Bearer <token>. Generar uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
INGESTA_TOKEN=
